APP_NAME=eduki-test
APP_ENV=local
# Generated automatically on first container start (or: docker compose exec api php artisan key:generate)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# These values are used BOTH by Laravel and by docker-compose.yml
# (the postgres service is initialised with DB_DATABASE / DB_USERNAME / DB_PASSWORD).
# DB_HOST/DB_PORT here are for running `php artisan` on the host machine
# (Postgres is published on 127.0.0.1:DB_HOST_PORT). Inside the api container
# docker-compose.yml overrides them with DB_HOST=db, DB_PORT=5432.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret

# Host port mappings (docker-compose only)
API_HOST_PORT=8080
DB_HOST_PORT=5432

# Number of PHP built-in server workers (handles concurrent requests)
PHP_CLI_SERVER_WORKERS=4

# No sessions, cache backend or queues are needed for a JSON API
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
